# Copy to .env with `make setup-env` (generates random secrets). Never commit .env.

# PostgreSQL 16 (docker container p3-profit-pg)
POSTGRES_USER=p3
POSTGRES_PASSWORD=change-me
POSTGRES_DB=p3
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5436

# Mock WooCommerce-style store API (basic auth: consumer key / secret)
STORE_API_URL=http://127.0.0.1:8008/wp-json/wc/v3
STORE_API_KEY=ck_change-me
STORE_API_SECRET=cs_change-me

# Cost sheet: a local CSV path or an http(s) URL (e.g. a Google Sheets CSV export link)
COST_SHEET_SOURCE=data/costs.csv

# Synthetic data generator
DATA_DIR=data
GEN_SEED=42
PAYMENT_FEE_PCT=2.75
PAYMENT_FEE_FIXED=1.00

# Weekly report + AI summary (Phase 3). No key = deterministic template summary.
# Provider: gemini (implemented). Same variable names as the invoice-extraction project.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
# LLM_API_KEY is also accepted as a fallback name
GEMINI_API_KEY=
# Optional; unset = provider default
LLM_TEMPERATURE=
# USD per million tokens, for the cost estimate logged in facts.json. Unset = "pricing not configured".
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=
# Summary language: en | ar
REPORT_LANG=en
# Runner/n8n: also build the editable PowerPoint (report.pptx) and attach it to the weekly email. true | false
REPORT_ATTACH_PPTX=true

# Runner API (Phase 4) called by n8n. Bound to 127.0.0.1; bearer token required.
RUNNER_API_TOKEN=change-me
RUNNER_HOST=127.0.0.1
RUNNER_PORT=8770

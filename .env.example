# Copy to .env with `make setup-env` (generates random secrets). Never commit .env.

# PostgreSQL 16 (docker container p3-profit-pg)
POSTGRES_USER=p3
POSTGRES_PASSWORD=change-me
POSTGRES_DB=p3
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5436

# Mock WooCommerce-style store API (basic auth: consumer key / secret)
STORE_API_URL=http://127.0.0.1:8008/wp-json/wc/v3
STORE_API_KEY=ck_change-me
STORE_API_SECRET=cs_change-me

# Cost sheet: a local CSV path or an http(s) URL (e.g. a Google Sheets CSV export link)
COST_SHEET_SOURCE=data/costs.csv

# Synthetic data generator
DATA_DIR=data
GEN_SEED=42
PAYMENT_FEE_PCT=2.75
PAYMENT_FEE_FIXED=1.00
